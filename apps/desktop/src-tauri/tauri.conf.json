{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mobile API Studio",
  "version": "0.0.1",
  "identifier": "dev.mobileapistudio.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Mobile API Studio",
        "width": 1320,
        "height": 840,
        "minWidth": 900,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "resources": [
      "../../../sidecars/mitm-addon/mas_bridge.py"
    ]
  }
}
