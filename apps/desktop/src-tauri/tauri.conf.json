{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mobile API Studio",
  "version": "0.0.1",
  "identifier": "dev.mobileapistudio.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Mobile API Studio",
        "width": 1320,
        "height": 840,
        "minWidth": 900,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.png"],
    "macOS": {
      "signingIdentity": "-"
    },
    "resources": {
      "../../../sidecars/mitm-addon/mas_bridge.py": "sidecars/mitm-addon/mas_bridge.py"
    }
  }
}
